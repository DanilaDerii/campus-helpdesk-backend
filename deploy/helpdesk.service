# Campus HelpDesk API. Installed by deploy/deploy.sh.
# /opt/campus-helpdesk/.env holds non-secret settings only; secrets come from Key Vault.

[Unit]
Description=Campus HelpDesk API
After=network-online.target docker.service
Wants=network-online.target
# Stop after 10 failures in 2 minutes so a permanent fault shows as "failed".
# Clear it with: sudo systemctl reset-failed helpdesk
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=helpdesk
Group=helpdesk
WorkingDirectory=/opt/campus-helpdesk
EnvironmentFile=/opt/campus-helpdesk/.env
ExecStart=/usr/bin/node dist/src/server.js
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5
MemoryMax=512M

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/campus-helpdesk

[Install]
WantedBy=multi-user.target
