# Campus HelpDesk API service unit.
#
# Target: Ubuntu 24.04. Install the HelpDesk journal retention drop-in first.
#
# Install:
#   sudo cp deploy/alex/helpdesk.service /etc/systemd/system/helpdesk.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now helpdesk
#
# Requires:
#   - the repository checked out and built at /opt/campus-helpdesk;
#   - a dedicated non-root service account:
#       sudo useradd --system --no-create-home --shell /usr/sbin/nologin helpdesk
#       sudo chown -R azureuser:helpdesk /opt/campus-helpdesk
#       sudo chmod -R g+rX /opt/campus-helpdesk
#   - /opt/campus-helpdesk/.env holding NON-SECRET settings only.
#     Production secrets are fetched at runtime through the SecretProvider.

[Unit]
Description=Campus HelpDesk API
After=network-online.target docker.service
Wants=network-online.target

# Give up after repeated rapid failures instead of restarting forever.
#
# Without a limit, a permanent fault restarts every RestartSec indefinitely: a
# missing .env once produced over four thousand restarts across roughly three
# hours, and because the unit never settles, `systemctl is-active` keeps
# reporting "activating" rather than "failed". That hides the fault and, on a
# burstable VM, spends CPU credits doing it.
#
# The window is deliberately generous. Startup reads secrets from Key Vault, so
# a cold boot can legitimately fail a few times while the network and the
# instance metadata service come up. Ten attempts inside two minutes rides that
# out, while a genuine misconfiguration lands in a clear "failed" state within
# about a minute. Clear it after fixing the cause with:
#   sudo systemctl reset-failed helpdesk
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=helpdesk
Group=helpdesk
WorkingDirectory=/opt/campus-helpdesk
EnvironmentFile=/opt/campus-helpdesk/.env
ExecStart=/usr/bin/node dist/src/server.js
LogNamespace=helpdesk
StandardOutput=journal
StandardError=journal

# Survive crashes and reboots. Paired with the start limit above, so a
# transient fault recovers while a permanent one stops and reports failed.
Restart=always
RestartSec=5

# Cap memory independently from PostgreSQL.
MemoryMax=512M

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/campus-helpdesk

[Install]
WantedBy=multi-user.target
