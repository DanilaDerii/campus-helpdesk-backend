generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  FACULTY
  TECHNICIAN
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  EXHAUSTED
}

model User {
  id           Int      @id @default(autoincrement())
  microsoftOid String   @unique @map("microsoft_oid") @db.VarChar(255)
  email        String   @unique @db.VarChar(320)
  displayName  String   @map("display_name") @db.VarChar(200)
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  requestedTickets  Ticket[]        @relation("TicketRequester")
  assignedTickets   Ticket[]        @relation("AssignedTechnician")
  comments          TicketComment[]
  historyChanges    TicketHistory[]

  @@map("users")
}

model TicketCategory {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(100)
  description String @default("") @db.VarChar(500)

  tickets Ticket[]

  @@map("ticket_categories")
}

model Ticket {
  id                   Int            @id @default(autoincrement())
  requesterId          Int            @map("requester_id")
  assignedTechnicianId Int?           @map("assigned_technician_id")
  categoryId           Int            @map("category_id")
  title                String         @db.VarChar(200)
  description          String         @default("") @db.Text
  location             String         @default("") @db.VarChar(200)
  status               TicketStatus   @default(OPEN)
  priority             TicketPriority @default(MEDIUM)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  resolvedAt           DateTime?      @map("resolved_at") @db.Timestamptz(3)

  requester          User           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignedTechnician User?          @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  category           TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments           TicketComment[]
  history            TicketHistory[]
  notifications      EmailNotification[]

  @@index([requesterId])
  @@index([assignedTechnicianId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

model TicketComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  authorId  Int      @map("author_id")
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([authorId])
  @@map("ticket_comments")
}

model TicketHistory {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  changedById Int?     @map("changed_by")
  action      String   @db.VarChar(100)
  oldValue    String   @default("") @map("old_value") @db.VarChar(500)
  newValue    String   @default("") @map("new_value") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([changedById])
  @@map("ticket_history")
}

model EmailNotification {
  id                Int            @id @default(autoincrement())
  ticketId          Int            @map("ticket_id")
  recipientEmail    String         @map("recipient_email") @db.VarChar(320)
  notificationType  String         @map("notification_type") @db.VarChar(100)
  deliveryStatus    DeliveryStatus @default(PENDING) @map("delivery_status")
  providerMessageId String?        @map("provider_message_id") @db.VarChar(255)
  errorMessage      String?        @map("error_message") @db.Text
  attemptCount      Int            @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([deliveryStatus, nextAttemptAt])
  @@map("email_notifications")
}
